# Bancos de dados — NÃO versionar no git (grandes demais para o GitHub).
# Backup fica no Google Drive via rclone (ver README).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Artefatos de sistema / editor
.DS_Store
*.swp
.harness/sync-cache.json

# Bytecode Python (regenerável)
__pycache__/
*.pyc

# Spike de flexões — artefatos gerados e ambiente local (o artefato StarDict
# contém conteúdo do Aurélio, uso estritamente pessoal: jamais versionar)
spike/*/dist/
spike/*/.venv/
spike/*/medicao-geracao.txt
spike/*/geracao-stdout.txt

# Build de produção (feature 002) — artefato derivado com conteúdo do Aurélio
# (uso estritamente pessoal: jamais versionar) e ambiente local do pipeline
dist/
pipeline/.venv/
pipeline/.coverage

# Conferência do alvo Readest (feature 003) — código de busca do Readest baixado
# (AGPL-3.0, não redistribuído) e dependências npm, ambos regeneráveis
pipeline/conferencia_readest/.cache/
pipeline/conferencia_readest/node_modules/
